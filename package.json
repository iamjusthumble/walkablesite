{
  "name": "walkablesite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/prerender.js",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test server/waitlist.test.js",
    "export:waitlist": "node scripts/export-waitlist.js",
    "email:test": "node --env-file-if-exists=.env scripts/test-email.js"
  },
  "dependencies": {
    "nodemailer": "^10.0.16",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
